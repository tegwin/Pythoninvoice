# Copy to .env and change every value before starting.
#   cp .env.example .env
# .env holds live credentials - keep it out of version control.

# --- Database ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=invoice_manager
MYSQL_USER=invoice
MYSQL_PASSWORD=change-me-app

# --- Application ---
# Signs session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing it logs everyone out.
SECRET_KEY=change-me-to-a-long-random-string

# Host port the app is published on. 5000 is taken by AirPlay/Docker on macOS.
APP_PORT=5001
